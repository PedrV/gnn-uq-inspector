# CPU-only Dockerfile for PyTorch + PyG training
FROM docker.io/ubuntu:24.04

LABEL maintainer="trainer"
LABEL version="1.1"
LABEL description="CPU-only Dev PyTorch GNN Training Environment with Jupyter"

ENV DEBIAN_FRONTEND=noninteractive

# Set environment variables for Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HYDRA_FULL_ERROR=1 \
    PYTHONPATH=/workspace \
    VIRTUAL_ENV=/workspace/dev_venv_r \
    PATH="/workspace/dev_venv_r/bin:$PATH"

ARG USERNAME=trainer
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN if getent group $USER_GID; then \
        echo "Group $USER_GID exists, skipping creation"; \
    else \
        groupadd --gid $USER_GID $USERNAME; \
    fi && \
    if getent passwd $USER_UID; then \
        echo "User $USER_UID exists, renaming it to $USERNAME"; \
        usermod -l $USERNAME $(getent passwd $USER_UID | cut -d: -f1); \
    else \
        useradd --uid $USER_UID --gid $USER_GID -m $USERNAME; \
    fi

WORKDIR /workspace
RUN chown $USERNAME:$USER_GID /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-dev \
        python3-venv \
        git \
        curl \
        build-essential \
        cmake \
    && rm -rf /var/lib/apt/lists/*

USER $USERNAME

RUN python3 -m venv $VIRTUAL_ENV && \
    pip install --upgrade pip && \
    pip install --no-cache-dir \
        torch==2.8.0 \
        --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
        pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv \
        -f https://data.pyg.org/whl/torch-2.8.0+cpu.html && \
    pip install --no-cache-dir \
        numpy==2.4.2 \
        torch_geometric==2.7.0 \
        seaborn==0.13.2 \
        hydra-core==1.3.2 \
        h5py==3.15.1 \
        scikit-learn==1.8.0 \
        pytest==9.0.1 \
        geopandas==1.1.1 \
        jupyterlab \
        ipywidgets \
        pyro-ppl \
        tueplots

EXPOSE 8888

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser"]
